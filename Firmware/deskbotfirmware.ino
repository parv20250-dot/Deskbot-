void wavheader(uint8_t*where,uint32_t amt){
	uint32_t v[11]={ 0x46464952,36 +amt,0x45564157,0x20746d66,16, 
		0x00010001,SAMPLE_RATE, SAMPLE_RATE * 2, 
		0x00100002,0x61746164,amt };memcpy(where,v,44);}
		//file format,size,wav format,audio format,samaple rate, byte rate, bits
		//per sample and audio data length, wav format idenitifiers
		//copies it from v to where and stores it
void startrec(int newstate){
	audbytes =0;
	state =newstate;
	showMessage("Listening....i think?");} //resets audio amt then changes state
