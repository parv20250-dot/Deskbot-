    if (state ==draft){display.print("Replydraft");}
    else{display.print("Deskbot");} //if draft draft else deskbot
    display.setTextColor(WHITE);
    for (int i =0; i<visible && top+i < linecount;i++){
        display.setCursor(0,12+i*9);
        display.print(lines[top+i]);} //starts at line 0, if too many lines 
        //scrolls down, increases i each time (line 0 i 0),find array prints,loop goes onn
    display.setCursor(0,56);
    if (state ==draft){display.print("A send, Ax2 nopee,B talk");}
    else{display.print("A to close,B to talk");}
    //if in draft mode shows draft related instructions else shows bot general ones
    display.display();} //updates display
void showtext (const String & body){
    //formats text, string input
    String str ="";
    for (size_t i=0;i<body.length();i++){ //starts at 0 to length,increase by 1 loop
         unsigned char c =body[i]; 
         if(c == '\n' or c=='t'){str+=' ';}//new lines,tabs become spaces
		 else if(c>=32 && c<127){str+=(char)c;}} //keeps normal characters, drops the rest
    linecount=0;
    String cur="";
    int i=0; //position
    int l =str.length(); //total length
    while (i<l && linecount< max_lines){ //while lines left,less than maximum possible
        int j=i;
        while(j<l && str[j]!=' ')j++;
        String w =str.substring(i,j); //word bw i,j
        i=j+1; //next word
        while((int)w.length()> characters && linecount< max_lines){
            if(cur.length()>0){lines[linecount]=cur;linecount++;cur="";}
            if(linecount>=max_lines)break;
            lines[linecount]=w.substring(0,characters); linecount++; //first 20 characters of long word
            w =w.substring(characters);} //removes from w
        if (w.length()==0){continue;} //empty word skipped
        if (cur.length()==0){cur =w;} //empty line? word
        else if((int)(cur.length()+1+w.length()) <= characters){
            cur +=" "+w;} //adds word
        else if(linecount< max_lines){lines[linecount]=cur;linecount++;cur =w;}}
    if (cur.length()>0 &&linecount< max_lines){ //lines left?
        lines[linecount]=cur;linecount++;} //saves and moves on
    top =0; //starts at top
    scrollat = millis()+2500;
    drawtext();}
void newdraft(const String& text){
    drafttext =text;state=draft;showtext(drafttext);ledcWriteTone(BUZZER_PIN,1760);
    beependat =millis()+200;} //draft,shows draft beeps to lmk

String req(const char*path, const char*type, const uint8_t*body,size_t len, 
int timeoutMS){
	if (WiFi.status() != WL_CONNECTED)return"";
	 //If no wifi return empty string
	HTTPClient http; //client object http
	http.setConnectTimeout(4000); //timeout after 4 secs of no conn
	http.setTimeout(timeoutMS); //timeout for an activity after conn
	http.begin(String(server_url)+path); //combines url with path(endpoint)
	http.addHeader("X-Deskbot-Key",API_key); //adds API key to request
	//authentication
	int code; 
	if (body){
		http.addHeader("Content-Type",type);
		code = http.POST((uint8_t*)body,len);}
	else code = http.GET(); //if body then it posts info to server
	//with content type deets and stores responses, otherwise no body=it needs
	//input from server sends a get request 
	String ans;
	if (code ==200){ans =http.getString();}//if code is 200,sucess,gets it and stores
	else{ans ="";} //returns empty string otherwise
	http.end(); //closes the connection
	return ans;} //returns the response
String post(const char* path, const char*text){
	return req(path,"text/plain",(const uint8_t*)text, strlen(text),3000);}
