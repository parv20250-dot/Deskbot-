#define audio_prefix "--deskbotbnd\r\nContent-Disposition:form-data;name=\"audio\";filename=\"voice.wav\"\r\nContent-Type:audio/wav\r\n\r\n"
#define audio_suffix "\r\n--deskbotbnd--\r\n"
#define prefix_len (sizeof(audio_prefix)- 1)
#define suffix_len (sizeof(audio_suffix)- 1)
void record(){
	int32_t samples[128];
	size_t no =i2s.readBytes((char*)samples, sizeof(samples))/4;
	//reads mic data basically, array is int, size then divides into no of 32 bit samples
	uint8_t*out = rec+prefix_len +44;
	//prefix space and wav header space
	for (size_t i=0;i<no;i++){ //loops through all samples goes forward when i < no
		if(audbytes+2>audmax)break; //checks space (audmax is max space)
		int32_t v=samples[i]>>14; //shifts sample
		if (v>32767)v=32767;
		if (v<-32768)v=-32768; //value fits in reqd range
		out[audbytes] = v&0xFF;
		audbytes++; //extracts lowest 8 bits and stores em
		out[audbytes]=(v>>8)&0xFF;
		audbytes++;}} //next 8 bits and stores em, does this till either all samples
		//done OR max capacity (bytes) reached 
void finishrec(){
 bool dictating=(state==uploading); //uploading state = recording audio reply
 if (audbytes<3200){ //if audio less than 0.1 secs
  if (dictating){state =draft;showtext(drafttext);}
  else{idlenow();}
  return;}//if recording too short ends function changes based on
  //what was being done before
 showMessage("Thinking...");
 memcpy(rec, audio_prefix,prefix_len); //writes prefix
 wavheader(rec+prefix_len,audbytes); //finds position,writes header after prefix
 memcpy(rec+prefix_len+44+audbytes,audio_suffix,suffix_len);
 //suffix after data
 const char* path;
 if(dictating){path ="/device/dictate";}
 else{path="/voice_text";} //sets paths depending on what state
 String response = req(path,"multipart/form-data; boundary=deskbotbnd",rec,
 (prefix_len+44+audbytes+suffix_len),45000); //creates a string and sends, waits 45 secs
 if(dictating){
  if(response.length()>0){newdraft(response);}
  else{state=draft;showtext(drafttext);}} //if server returned sumn new draft else nun
 else if(response.length()>0){ //not dictating
  state = reply;
  showtext(response); //state to reply and shows response
  ledcWriteTone(BUZZER_PIN,1760); //plays notif sound
  beependat=millis()+200;}
 else{idlenow();}} //if neither aka server empty idle state
void updatebutton(Button& b){ //updates button info
	uint32_t now = millis(); //now = ms since esp starts
	bool isdown =(digitalRead(b.pin)==LOW); //pressed or nay
	b.justpressed =false;
	b.justreleased =false;
	if (isdown!= b.raw){b.raw =isdown;b.lastchange=now;}
	//if there is a change then chnages button state, updates time of last change
	if (now -b.lastchange>=30 && isdown!= b.stable){
		//diff reading than stable, check time
		b.stable =isdown;
		if(isdown){b.justpressed =true;b.pressedat=now;}
		//if pressed then pressed is true,time pressed at is now
		else{b.justreleased =true;}}}//if not a press its a release
