			else{singleB();}}} //stop pressing B actions

void setup(){
	Serial.begin(115200); //starts communiction
	pinMode(Button_1,INPUT_PULLUP); //signals, high when no press
	pinMode(Button_2,INPUT_PULLUP); //signals, high when no press
	ledcAttach(BUZZER_PIN,2000,10); //configures buzzer
	ledcWriteTone(BUZZER_PIN,0); //starts silent
	Wire.begin(SDA_PIN,SCL_PIN); //Sets up I2C communication lines for display
	Wire.setClock(300000); //I2C clock speed
	display.begin(SSD1306_SWITCHCAPVCC,0x3c); //Initialises display
	if(psramFound()){audmax =(size_t)SAMPLE_RATE*2*15;}
	//15 second audio, calculates space to allocate
	else{audmax =(size_t)SAMPLE_RATE*2*8;} //8secs
	size_t total =prefix_len+44+audmax+suffix_len; //total mem reqd
	if (psramFound()){rec =(uint8_t*)ps_malloc(total);} //allocates memory in psram
	else{rec=(uint8_t*)malloc(total);}//allocates memory in normal ram
	i2s.setPins(MIC_SCK,MIC_WS,-1,MIC_SD); //ASSIGNS DEFINES PINS
	i2s.begin(I2S_MODE_STD,SAMPLE_RATE,I2S_DATA_BIT_WIDTH_32BIT,
		I2S_SLOT_MODE_MONO, I2S_STD_SLOT_LEFT); //initialises mic
	showMessage("WiFi...");//shows a message while connecting
	WiFi.mode(WIFI_STA); //sets mode to connect to existing network
	WiFi.begin(WIFI_SSID,WIFI_PASS); //NETWORK nam e and password
	uint32_t t0 =millis(); //time starts
	while (WiFi.status() != WL_CONNECTED && millis()-t0 <15000)delay(200);
	//while wifi not connected and less than 15 secs have passed wai 200 ms
	//then tries again
	if (WiFi.status()== WL_CONNECTED){Serial.println(WiFi.localIP().toString());}
	//if wifi is connected, prints ip adress after making it str
	else{Serial.println("WIFI failedd");} //if no connect prints failes
	randomSeed(esp_random()); //generates random seed
	idlenow();}

	void loop(){
		uint32_t now= millis();
		updatebutton(buttonA);
		updatebutton(buttonB);
		buttonsfinale(now); //updates button info and both buttons actions
		if(beependat&&now >= beependat){
			ledcWriteTone(BUZZER_PIN,0);beependat=0;}
		//if there is a beep end at now is more than beep end,aka beep time over
		//silences buzzer then resets beep end at
		if(state == uploading or state == recording){record();}
		//if its in ask a question or record modes it records
		else if (state == idle){
			if (now >=nextfaceat)updateface(); //time to update face, updates face
			if(now-lastcheckedat>=2000){lastcheckedat=now;
			String r =req("/device/poll",nullptr,nullptr,0,2500);
			//study or idle
			if(r.startsWith("draft:"))newdraft(r.substring(6)); 
			//if response starts with draft then extracts conetent from 6 as new draft
			else if(r.length()&&(r.indexOf("study")>=0)!= studymode){
				//if it has characters, if there's study (else it'd be-1 so false) and diff
				studymode =!studymode; //updates mode
				drawface();}}}
			else if (linecount> visible && now >=scrollat){ 
				//line count more than what fits on screen at once, tiem to scroll
				if(top+visible > linecount){top=0;} //resets
				else{top=top +1;}//scrolls instead of starting over
				if(top ==0){scrollat = now+2000;} //2 s at beginning
				else{scrollat =now+1500;}//1s after
				drawtext();}}
